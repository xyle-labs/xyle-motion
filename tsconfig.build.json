{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "src",
    "bin"
  ],
  "exclude": [
    "src/*.test.ts"
  ]
}
